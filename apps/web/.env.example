# Onde está a API, vista pelo SERVIDOR da web (o proxy /api/* reencaminha para aqui).
# Em produção: o endereço da API no Render (ex.: https://convocados-api.onrender.com)
API_URL=http://localhost:3001

# Onde está a API, vista pelo BROWSER: só para o socket (tempo real), que liga direto.
NEXT_PUBLIC_API_URL=http://localhost:3001

# O mesmo PROXY_SECRET da API (obrigatório em produção). Gera um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PROXY_SECRET=

# Nº de proxies à frente da web (Render = 1), para o proxy saber o IP de quem pede.
TRUST_PROXY=0

# Email de contacto mostrado na política de privacidade (opcional).
# NEXT_PUBLIC_CONTACT_EMAIL=
