DATABASE_URL=postgres://convocados:convocados@localhost:5435/convocados
PORT=3001
# Origens do web autorizadas (CORS), separadas por vírgula.
# Para abrir o web no telemóvel: http://localhost:3000,http://192.168.1.X:3000
WEB_ORIGIN=http://localhost:3000
DB_SYNCHRONIZE=false
SESSION_TTL_DAYS=30
ALLOW_REGISTRATION=true
# COOKIE_SECURE=false
# Pedidos por minuto e por IP (login/registo: 10; convites: 30)
RATE_LIMIT_PER_MIN=120
# Nº de proxies à frente da API. No Render: 1 (senão todos os pedidos parecem vir do mesmo IP)
TRUST_PROXY=0

# Fase 5 — IA (Groq). Sem key: parse devolve ok:false → formulário manual.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_DAILY_LIMIT=10

# Proxy da web: o mesmo valor aqui e no apps/web (obrigatório em produção).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PROXY_SECRET=
# Assina os tokens curtos do socket da web. Vazio = um novo a cada arranque (chega com 1 servidor).
# SOCKET_TOKEN_SECRET=

# Recuperar a password por email (Resend, grátis até 100/dia). Sem chave, em dev o link aparece no log da API.
RESEND_API_KEY=
EMAIL_FROM=Convocados <onboarding@resend.dev>
# Endereço público da web, para os links nos emails (vazio = o 1.º do WEB_ORIGIN).
# APP_URL=https://convocados-web.onrender.com

# Importar campos do OpenStreetMap (pnpm --filter api venues:import). Opcionais.
# Instância pública do Overpass (outra: https://overpass.kumi.systems/api/interpreter)
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# OVERPASS_USER_AGENT=Convocados/1.0 (venue import; +https://github.com/PedroPinho17/convocados)
